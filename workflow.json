      "parameters": {
        "jsCode": "const items = $input.first().json.data;\n\nlet html = '<h2>Resumen de noticias de hoy</h2>';\nitems.forEach(item => {\n  html += `\n    <div style=\"margin-bottom: 20px; padding-bottom: 15px; border-bottom: 1px solid #ddd;\">\n      <p style=\"margin: 0; font-size: 15px; line-height: 1.5;\">${item.text}</p>\n    </div>\n  `;\n});\n\nreturn [{ json: { html } }];"
      },
